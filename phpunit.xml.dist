<?xml version="1.0" encoding="UTF-8"?>
<!--
    Standalone unit test configuration (used by CI). Inside a Magento install, `make unit` uses Magento's own
    dev/tests/unit configuration instead. Pass the Composer autoloader with bootstrap=... or (CLI) bootstrap option.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Company_SupplierSync unit">
            <directory>Test/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
