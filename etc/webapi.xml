<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/supplier-sync/updates" method="POST">
        <service class="Company\SupplierSync\Api\StockUpdateManagementInterface" method="submit"/>
        <resources>
            <resource ref="Company_SupplierSync::updates_write"/>
        </resources>
    </route>
    <route url="/V1/supplier-sync/updates/:updateId" method="GET">
        <service class="Company\SupplierSync\Api\StockUpdateStatusRepositoryInterface" method="get"/>
        <resources>
            <resource ref="Company_SupplierSync::updates_read"/>
        </resources>
    </route>
    <route url="/V1/supplier-sync/inventory" method="GET">
        <service class="Company\SupplierSync\Api\InventoryQueryInterface" method="get"/>
        <resources>
            <resource ref="Company_SupplierSync::inventory_read"/>
        </resources>
    </route>
</routes>
